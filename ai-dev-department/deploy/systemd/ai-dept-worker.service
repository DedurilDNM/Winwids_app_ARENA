# AI Dev Department — arq queue worker (run_project jobs + 5-min session
# health-check cron). Requires Redis (REDIS_URL in server/.env).
#
# Install:
#   sudo cp deploy/systemd/ai-dept-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ai-dept-worker

[Unit]
Description=AI Dev Department queue worker (arq)
Documentation=file:///opt/ai-dev-department/deploy/README.md
After=network-online.target redis-server.service ai-dept-api.service
Wants=network-online.target ai-dept-api.service
Requires=redis-server.service
# Give up after 10 crashes in 5 minutes (then: journalctl -u <unit>).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=aidept
Group=aidept
WorkingDirectory=/opt/ai-dev-department/server
Environment=HOME=/opt/ai-dev-department/server/data/home
Environment=PYTHONUNBUFFERED=1
Environment=ENVIRONMENT=production
EnvironmentFile=-/etc/ai-dept/worker.env
ExecStartPre=/usr/bin/mkdir -p /opt/ai-dev-department/server/data/home
ExecStart=/opt/ai-dev-department/server/.venv/bin/python -m arq app.workers.settings.WorkerSettings
# arq handles SIGTERM itself (stops polling, cancels/finishes jobs); give it
# time to clean up browsers before SIGKILL. A project interrupted by a restart
# can be started again from the client.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
