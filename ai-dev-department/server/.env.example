# ---------------------------------------------------------------------------
# AI Dev Department - server configuration
# Copy to .env and adjust. .env is chmod 600 and never committed.
# FERNET_KEY and JWT_SECRET are AUTO-GENERATED on first run if left empty.
# ---------------------------------------------------------------------------

# --- External AI service (fill SERVICE_URL with your service) ---
SERVICE_URL=https://example.com
SERVICE_DISPLAY_NAME="External AI Service"
ADAPTER_MODULE=app.adapters.generic.adapter
# All traffic to the service goes through this single HTTP proxy:
PROXY_URL=http://user:pass@1.2.3.4:8080

# --- Secrets (auto-generated on first run; leave empty) ---
FERNET_KEY=
JWT_SECRET=

# --- First-run admin seeding (used only when the users table is empty) ---
# If empty, a random one-time password is printed to stdout on first run.
ADMIN_PASSWORD=

# --- Database ---
# Default: SQLite file at server/data/app.db. For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aidept
DATABASE_URL=

# --- Redis (task queue for the worker, Phase 3) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub (server-side watcher polls /status/*.md via raw HTTP) ---
GITHUB_API_URL=https://api.github.com
# Optional: server-side token for the watcher (public repos work without it).
# A per-user encrypted ConnectorCredential (kind=github) takes precedence.
GITHUB_TOKEN=
# GitHub API is not service traffic; leave empty unless your network needs a proxy.
GITHUB_PROXY_URL=
GITHUB_POLL_INTERVAL_SECONDS=15
TASK_TIMEOUT_SECONDS=3600
ORCHESTRATOR_TIMEOUT_SECONDS=600
AGENT_TIMEOUT_SECONDS=600   # no activity for this long = timeout
# ADAPTER_MAX_REPLY_SECONDS=3600
# ADAPTER_INCOMPLETE_SETTLE_SECONDS=120

# --- VNC / noVNC (Phase 2) ---
# Base URL the client should open. Prod: https://app.<domain>/novnc
NOVNC_PUBLIC_BASE_URL=http://127.0.0.1:6080
NOVNC_WEB_ROOT=/usr/share/novnc
WEBSOCKIFY_HOST=127.0.0.1
WEBSOCKIFY_PORT=6080
XVFB_BASE_DISPLAY=97
VNC_SHARED_DISPLAY=99
VNC_BASE_RFB_PORT=5901
VNC_WIDTH=1600
VNC_HEIGHT=900
# Test/CI only: launch Camoufox headless, skip Xvfb/x11vnc/noVNC
VNC_HEADLESS=false

# --- Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated; dev = localhost, prod = your client domain) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Environment ---
ENVIRONMENT=development

# Auto-login (accounts with a login e-mail + password in the app): defaults fit a
# «Log in» button -> e-mail -> password form; change only if the service differs.
# ADAPTER_LOGIN_OPEN_SELECTOR=button:text-is("Log in") || a:text-is("Log in")
# ADAPTER_AUTO_LOGIN_PER_HOUR=2
# Model check (accounts with «Модель» set): the model button must show its name.
# ADAPTER_MODEL_CHECK=true
# ADAPTER_MODEL_CLICKS=
# Chat toolbar, chosen by visible labels before every new chat:
# ADAPTER_CHAT_MODE=Chat
# ADAPTER_MODALITY=Code
# ADAPTER_MODEL_AUTO=true      (pick the account's model in the model menu)

# --- Reliability ---
# Projects interrupted by a restart continue by themselves (false = mark failed)
# AUTO_RESUME_INTERRUPTED=true
# Before a project starts: check every account, calibrate the ones without a fresh calibration
# PREFLIGHT_ENABLED=true
# PREFLIGHT_CALIBRATION_MAX_AGE_HOURS=72
# Reply with no new text for this long: reload the chat in place (0 = off)
# ADAPTER_STUCK_REFRESH_SECONDS=300
# Unfinished-looking reply (no STATUS / JSON yet) is taken after this many seconds unchanged
# ADAPTER_INCOMPLETE_SETTLE_SECONDS=120
# Pulse of a waiting agent sent to the app every N seconds
# ADAPTER_PROGRESS_SECONDS=10
# A finished reply is read with its «copy» button (whole answer, markdown); the page
# reader is the fallback. Set the selector only if the button is not found by itself.
# ADAPTER_COPY_READER=true
# ADAPTER_COPY_SELECTOR=
