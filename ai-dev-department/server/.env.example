# ---------------------------------------------------------------------------
# AI Dev Department - server configuration
# Copy to .env and adjust. .env is chmod 600 and never committed.
# FERNET_KEY and JWT_SECRET are AUTO-GENERATED on first run if left empty.
# ---------------------------------------------------------------------------

# --- External AI service (fill SERVICE_URL with your service) ---
SERVICE_URL=https://example.com
SERVICE_DISPLAY_NAME="External AI Service"
ADAPTER_MODULE=app.adapters.generic.adapter
# All traffic to the service goes through this single HTTP proxy:
PROXY_URL=http://user:pass@1.2.3.4:8080

# --- Secrets (auto-generated on first run; leave empty) ---
FERNET_KEY=
JWT_SECRET=

# --- First-run admin seeding (used only when the users table is empty) ---
# If empty, a random one-time password is printed to stdout on first run.
ADMIN_PASSWORD=

# --- Database ---
# Default: SQLite file at server/data/app.db. For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aidept
DATABASE_URL=

# --- Redis (task queue for the worker, Phase 3) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub (server-side watcher polls /status/*.md via raw HTTP) ---
GITHUB_API_URL=https://api.github.com

# --- VNC / noVNC (Phase 2) ---
# Base URL the client should open. Prod: https://app.<domain>/novnc
NOVNC_PUBLIC_BASE_URL=http://127.0.0.1:6080
NOVNC_WEB_ROOT=/usr/share/novnc
WEBSOCKIFY_HOST=127.0.0.1
WEBSOCKIFY_PORT=6080
XVFB_BASE_DISPLAY=97
VNC_SHARED_DISPLAY=99
VNC_BASE_RFB_PORT=5901
VNC_WIDTH=1600
VNC_HEIGHT=900
# Test/CI only: launch Camoufox headless, skip Xvfb/x11vnc/noVNC
VNC_HEADLESS=false

# --- Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated; dev = localhost, prod = your client domain) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Environment ---
ENVIRONMENT=development
